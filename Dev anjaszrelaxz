local function createRemoteItem(remote)
	if itemUiObjects[remote] then return end

	local item = Instance.new("Frame")
	item.Size = UDim2.new(1, -6, 0, 46)
	item.BackgroundColor3 = Color3.fromRGB(28, 30, 41)
