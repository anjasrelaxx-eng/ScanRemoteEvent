--// BRUTAL TESTING RUNNER
local brutalThreadActive = false
actionBtn.MouseButton1Click:Connect(function()
	if brutalThreadActive then
		brutalThreadActive = false
		actionBtn.Text = "EXECUTE TEST"
		actionBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 0)
		return
	end

	local txt = limitBox.Text:lower()
	local countLimit = tonumber(txt) or 100
	local isInfinite = (countLimit == 0 or txt == "inf" or txt == "infinite")
	
	local activeQueue = {}
	for remote, isSelected in pairs(selectedRemotes) do
		if isSelected and remote:IsA("RemoteEvent") then
			table.insert(activeQueue, remote)
		end
	end

	if #activeQueue == 0 then
		actionBtn.Text = "NO SELECTION"
		task.wait(0.8)
		actionBtn.Text = "EXECUTE TEST"
		return
	end

	brutalThreadActive = true
	actionBtn.Text = "🛑 STOP TEST"
	actionBtn.BackgroundColor3 = Color3.fromRGB(225, 55, 55)

	task.spawn(function()
		local iteration = 0
		while brutalThreadActive do
			if not isInfinite and iteration >= countLimit then break end
			
			for i = 1, #activeQueue do
				local targetRemote = activeQueue[i]
				task.spawn(function()
					targetRemote:FireServer(true, "RELAX_BRUTAL_STRESS_DATA", tick())
				end)
			end
			
			iteration = iteration + 1
			task.wait()
		end
		brutalThreadActive = false
		actionBtn.Text = "EXECUTE TEST"
		actionBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 0)
	end)
end)

