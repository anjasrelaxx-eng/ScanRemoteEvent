	local checkbox = Instance.new("TextButton", item)
	checkbox.Size = UDim2.new(0, 22, 0, 22)
	checkbox.Position = UDim2.new(0, 10, 0.5, -11)
	checkbox.BackgroundColor3 = Color3.fromRGB(43, 48, 65)
	checkbox.Text = ""
	checkbox.TextColor3 = Color3.new(1,1,1)
	checkbox.Font = Enum.Font.GothamBold
	checkbox.TextSize = 11
	Instance.new("UICorner", checkbox).CornerRadius = UDim.new(0, 5)

	local rName = Instance.new("TextLabel", item)
	rName.Size = UDim2.new(0.85, -45, 0.45, 0)
	rName.Position = UDim2.new(0, 42, 0.1, 0)
	rName.BackgroundTransparency = 1
	rName.Text = remote.Name == "" and "(NoNameRemote)" or remote.Name
	rName.TextColor3 = Color3.fromRGB(230, 235, 245)
	rName.Font = Enum.Font.GothamBold
	rName.TextSize = 12
	rName.TextXAlignment = Enum.TextXAlignment.Left

	local rPath = Instance.new("TextLabel", item)
	rPath.Size = UDim2.new(0.85, -45, 0.4, 0)
	rPath.Position = UDim2.new(0, 42, 0.5, 0)
	rPath.BackgroundTransparency = 1
	rPath.Text = remote:GetFullName()
	rPath.TextColor3 = Color3.fromRGB(110, 115, 130)
	rPath.Font = Enum.Font.Code
	rPath.TextSize = 9
	rPath.TextXAlignment = Enum.TextXAlignment.Left

	table.insert(targetRemotes, remote)
	selectedRemotes[remote] = false
	itemUiObjects[remote] = item

	local function updateVisual(forceState)
		if forceState ~= nil then
			selectedRemotes[remote] = forceState
		end
		
		if selectedRemotes[remote] then
			checkbox.BackgroundColor3 = Color3.fromRGB(0, 175, 95)
			checkbox.Text = "✓"
			item.BackgroundColor3 = Color3.fromRGB(30, 44, 38)
		else
			checkbox.BackgroundColor3 = Color3.fromRGB(43, 48, 65)
			checkbox.Text = ""
			item.BackgroundColor3 = Color3.fromRGB(28, 30, 41)
		end
	end

	checkbox.MouseButton1Click:Connect(function()
		selectedRemotes[remote] = not selectedRemotes[remote]
		updateVisual()
	end)

	itemToggleCallbacks[remote] = updateVisual
end

